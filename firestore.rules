rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin() { return signedIn() && profile().role == 'siteAdmin'; }
    function organizer() { return signedIn() && profile().role in ['siteAdmin', 'commissioner', 'leagueManager']; }
    function manages(teamId) { return organizer() || (signedIn() && profile().role == 'teamManager' && profile().linkedTeamId == teamId); }
    function ownsPlayer(playerId) {
      return signedIn() && ((profile().role in ['player', 'captain'] && profile().linkedPlayerId == playerId) ||
        (profile().role == 'parent' && playerId in profile().linkedPlayerIds));
    }
    function validProfile(d) {
      return d.keys().hasOnly(['email', 'displayName', 'role', 'linkedTeamId', 'linkedPlayerId', 'linkedPlayerIds', 'createdAt', 'acceptedInvitationId', 'emailReminders']) &&
        d.get('emailReminders', true) is bool &&
        d.email is string && d.displayName is string && d.displayName.size() <= 100 &&
        d.role in ['siteAdmin', 'commissioner', 'leagueManager', 'teamManager', 'captain', 'player', 'parent', 'umpire', 'scorekeeper', 'visitor'] &&
        (d.linkedTeamId == null || d.linkedTeamId is string) &&
        (d.linkedPlayerId == null || d.linkedPlayerId is string) && d.get('linkedPlayerIds', []) is list && d.get('linkedPlayerIds', []).size() <= 30;
    }
    function invitationRecipient(invite) {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == invite.email;
    }
    function matchesInvitation(user, invite) {
      return validInvitationLinks(invite) && user.role == invite.role && user.linkedTeamId == invite.linkedTeamId &&
        user.linkedPlayerId == invite.linkedPlayerId && user.linkedPlayerIds == invite.linkedPlayerIds;
    }
    function validInvitationPlayer(invite) {
      let player = getAfter(/databases/$(database)/documents/players/$(invite.linkedPlayerId)).data;
      return player.get('archived', false) == false && player.teamId == invite.linkedTeamId &&
        existsAfter(/databases/$(database)/documents/teams/$(player.teamId));
    }
    function validInvitationLinks(invite) {
      return (invite.role == 'teamManager' && invite.linkedTeamId is string && invite.linkedPlayerId == null && invite.linkedPlayerIds == [] &&
          existsAfter(/databases/$(database)/documents/teams/$(invite.linkedTeamId))) ||
        (invite.role in ['player', 'captain'] && invite.linkedPlayerId is string && invite.linkedTeamId is string && invite.linkedPlayerIds == [] && validInvitationPlayer(invite)) ||
        (invite.role == 'parent' && invite.linkedTeamId == null && invite.linkedPlayerId == null && invite.linkedPlayerIds is list &&
          invite.linkedPlayerIds.size() > 0 && invite.linkedPlayerIds.size() <= 30 && invite.linkedPlayerIds.toSet().size() == invite.linkedPlayerIds.size()) ||
        (invite.role in ['commissioner', 'leagueManager', 'umpire', 'scorekeeper'] && invite.linkedTeamId == null && invite.linkedPlayerId == null && invite.linkedPlayerIds == []);
    }
    function acceptsInvitation(uid) {
      let id = request.resource.data.acceptedInvitationId;
      let invite = get(/databases/$(database)/documents/invitations/$(id)).data;
      let accepted = getAfter(/databases/$(database)/documents/invitations/$(id)).data;
      return request.auth.uid == uid && resource.data.role in ['player', 'visitor'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'linkedTeamId', 'linkedPlayerId', 'linkedPlayerIds', 'acceptedInvitationId']) &&
        invitationRecipient(invite) && invite.status == 'pending' && invite.expiresAt > request.time &&
        accepted.status == 'accepted' && accepted.acceptedBy == uid && matchesInvitation(request.resource.data, invite);
    }
    match /invitations/{id} {
      allow get: if admin() || (signedIn() && request.auth.token.email.lower() == resource.data.email);
      allow list: if admin();
      allow create: if admin() && request.resource.data.keys().hasOnly(['email', 'role', 'linkedTeamId', 'linkedPlayerId', 'linkedPlayerIds', 'status', 'createdBy', 'createdAt', 'expiresAt']) &&
        request.resource.data.email is string && request.resource.data.email == request.resource.data.email.lower() &&
        request.resource.data.role in ['commissioner', 'leagueManager', 'teamManager', 'captain', 'player', 'parent', 'umpire', 'scorekeeper'] &&
        (request.resource.data.linkedTeamId == null || request.resource.data.linkedTeamId is string) &&
        (request.resource.data.linkedPlayerId == null || request.resource.data.linkedPlayerId is string) &&
        request.resource.data.linkedPlayerIds is list && request.resource.data.linkedPlayerIds.size() <= 30 &&
        validInvitationLinks(request.resource.data) && request.resource.data.status == 'pending' && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if (admin() && resource.data.status == 'pending' && request.resource.data.status == 'revoked' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        (invitationRecipient(resource.data) && resource.data.status == 'pending' && resource.data.expiresAt > request.time &&
        request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid && request.resource.data.acceptedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.acceptedInvitationId == id &&
        matchesInvitation(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data, resource.data));
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin() || (organizer() && resource.data.role == 'scorekeeper'));
      allow list: if admin() || (organizer() && resource.data.role == 'scorekeeper');
      allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data) &&
        request.resource.data.email == request.auth.token.email && request.resource.data.role == 'player' &&
        request.resource.data.linkedTeamId == null && request.resource.data.linkedPlayerId == null && request.resource.data.linkedPlayerIds == [];
      allow update: if validProfile(request.resource.data) && (admin() || (signedIn() && request.auth.uid == uid &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'emailReminders']) || acceptsInvitation(uid))));
      allow delete: if false;
    }
    match /teams/{id} {
      allow read: if true;
      allow create: if organizer() && validTeam(request.resource.data);
      allow delete: if organizer() && scheduleAdvanced() && rosterAdvanced();
      allow update: if manages(id) && validTeam(request.resource.data);
    }
    function boundedText(value, limit) { return value is string && value.size() <= limit; }
    function validName(value) { return boundedText(value, 100) && value.matches('.*[^\\s].*'); }
    function validTeam(d) {
      return d.keys().hasOnly(['name', 'color', 'homefield']) && validName(d.name) &&
        boundedText(d.get('color', ''), 40) && boundedText(d.get('homefield', ''), 100);
    }
    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'number', 'phone', 'teamId', 'archived']) && validName(d.name) &&
        boundedText(d.get('number', ''), 10) && boundedText(d.get('phone', ''), 40) &&
        d.get('archived', false) is bool && d.teamId is string &&
        existsAfter(/databases/$(database)/documents/teams/$(d.teamId));
    }
    match /fields/{id} {
      allow read: if true;
      allow create, update: if organizer() && scheduleAdvanced() && validField(request.resource.data);
      allow delete: if organizer() && scheduleAdvanced();
    }
    function validField(d) {
      return d.keys().hasOnly(['name', 'availableDays', 'openTime', 'closeTime', 'hasLights', 'zipCode']) &&
        validName(d.name) && d.openTime is string && d.closeTime is string &&
        d.openTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]') && d.closeTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]') && d.openTime < d.closeTime &&
        d.availableDays is list && d.availableDays.size() > 0 && d.availableDays.size() <= 7 &&
        d.availableDays.hasOnly([0, 1, 2, 3, 4, 5, 6]) && d.availableDays.toSet().size() == d.availableDays.size() &&
        d.hasLights is bool && d.zipCode is string &&
        ((d.hasLights && d.zipCode == '') || d.zipCode.matches('[0-9]{5}'));
    }
    match /config/{id} {
      allow read: if true;
      allow write: if (id == 'rosterRevision' && signedIn() && (organizer() || profile().role == 'teamManager') &&
        request.resource.data.keys().hasOnly(['revision', 'updatedBy']) && request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.revision is int && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)) ||
        (organizer() && ((id == 'schedule' && scheduleAdvanced() && validSeason(request.resource.data)) || (id != 'schedule' && id != 'scheduleRevision' && id != 'rosterRevision') ||
        (id == 'scheduleRevision' && request.resource.data.keys().hasOnly(['revision', 'updatedBy']) && request.resource.data.updatedBy == request.auth.uid &&
         request.resource.data.revision is int && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1))));
    }
    function seasonDate(value) {
      return timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10]));
    }
    function validSeasonDate(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        seasonDate(value).year() == int(value[0:4]) && seasonDate(value).month() == int(value[5:7]) && seasonDate(value).day() == int(value[8:10]);
    }
    function validSeason(d) {
      return d.keys().hasOnly(['startDate', 'endDate', 'gameDuration', 'bufferMinutes', 'rounds']) &&
        d.gameDuration is int && d.gameDuration >= 1 && d.gameDuration <= 1440 &&
        d.bufferMinutes is int && d.bufferMinutes >= 0 && d.bufferMinutes <= 1440 &&
        d.rounds is int && d.rounds >= 1 && d.rounds <= 20 &&
        validSeasonDate(d.startDate) && validSeasonDate(d.endDate) && d.startDate <= d.endDate &&
        seasonDate(d.endDate) - seasonDate(d.startDate) <= duration.value(366, 'd');
    }
    function rosterMatches(id) {
      let player = getAfter(/databases/$(database)/documents/players/$(id)).data;
      let roster = getAfter(/databases/$(database)/documents/teamRoster/$(id)).data;
      return roster.keys().hasOnly(['name', 'number', 'teamId', 'archived']) &&
        roster.name == player.name && roster.number == player.get('number', '') &&
        roster.teamId == player.teamId && roster.archived == player.get('archived', false);
    }
    function captains(teamId) {
      return signedIn() && profile().role == 'captain' &&
        get(/databases/$(database)/documents/players/$(profile().linkedPlayerId)).data.teamId == teamId &&
        get(/databases/$(database)/documents/players/$(profile().linkedPlayerId)).data.get('archived', false) == false;
    }
    match /teamRoster/{id} {
      allow read: if manages(resource.data.teamId) || captains(resource.data.teamId);
      allow create: if manages(request.resource.data.teamId) && rosterMatches(id);
      allow update: if manages(resource.data.teamId) && manages(request.resource.data.teamId) && rosterMatches(id);
      allow delete: if manages(resource.data.teamId) && !existsAfter(/databases/$(database)/documents/players/$(id));
    }
    match /players/{id} {
      allow read: if manages(resource.data.teamId) || ownsPlayer(id);
      allow create: if manages(request.resource.data.teamId) && validPlayer(request.resource.data) && rosterMatches(id) && rosterAdvanced();
      allow update: if manages(resource.data.teamId) && manages(request.resource.data.teamId) && validPlayer(request.resource.data) && rosterMatches(id) &&
        (request.resource.data.teamId == resource.data.teamId || rosterAdvanced());
      allow delete: if manages(resource.data.teamId) && !existsAfter(/databases/$(database)/documents/teamRoster/$(id));
    }
    function validScore(d) {
      return d.homeScore is int && d.homeScore >= 0 && d.homeScore <= 9007199254740991 &&
        d.awayScore is int && d.awayScore >= 0 && d.awayScore <= 9007199254740991 && validBases(d.get('bases', {'first': false, 'second': false, 'third': false})) &&
        validCounter(d.get('inning', 1), 1, 99) && d.get('half', 'top') in ['top', 'bottom'] &&
        validCounter(d.get('balls', 0), 0, 3) && validCounter(d.get('strikes', 0), 0, 2) && validCounter(d.get('outs', 0), 0, 2);
    }
    function validCounter(value, minimum, maximum) { return value is int && value >= minimum && value <= maximum; }
    function validBases(b) { return b is map && b.keys().hasOnly(['first', 'second', 'third']) && b.first is bool && b.second is bool && b.third is bool; }
    function scheduleAdvanced() {
      let path = /databases/$(database)/documents/config/scheduleRevision;
      return getAfter(path).data.revision == (exists(path) ? get(path).data.revision + 1 : 1) && getAfter(path).data.updatedBy == request.auth.uid;
    }
    function rosterAdvanced() {
      let path = /databases/$(database)/documents/config/rosterRevision;
      return getAfter(path).data.revision == (exists(path) ? get(path).data.revision + 1 : 1) && getAfter(path).data.updatedBy == request.auth.uid;
    }
    function scoreState(d) {
      return {'homeScore': d.get('homeScore', null), 'awayScore': d.get('awayScore', null), 'status': d.status,
        'inning': d.get('inning', 1), 'half': d.get('half', 'top'), 'balls': d.get('balls', 0), 'strikes': d.get('strikes', 0), 'outs': d.get('outs', 0),
        'bases': d.get('bases', {'first': false, 'second': false, 'third': false}), 'lineScore': d.get('lineScore', {}), 'scoreCarry': d.get('scoreCarry', null), 'lineScoreInning': d.get('lineScoreInning', null)};
    }
    function scoreNumber(d, key) { return d.get(key, null) == null ? 0 : d[key]; }
    function validInningChange(before, after) {
      let old = before.get('lineScore', {});
      let key = string(after.get('lineScoreInning', 1));
      let previous = old.get(key, {'home': 0, 'away': 0});
      let cell = after.lineScore.get(key, {'home': 0, 'away': 0});
      return after.lineScore is map && after.scoreCarry == before.get('scoreCarry', {'home': scoreNumber(before, 'homeScore'), 'away': scoreNumber(before, 'awayScore')}) &&
        after.lineScore.diff(old).affectedKeys().hasOnly([key]) && cell.keys().hasOnly(['home', 'away']) &&
        cell.home is int && cell.home >= 0 && cell.away is int && cell.away >= 0 &&
        after.lineScoreInning is int && after.lineScoreInning >= 1 && after.lineScoreInning <= 99 &&
        after.homeScore == scoreNumber(before, 'homeScore') + cell.home - previous.home &&
        after.awayScore == scoreNumber(before, 'awayScore') + cell.away - previous.away;
    }
    function validLineScore(before, after) {
      return (!before.keys().hasAny(['lineScore', 'scoreCarry', 'lineScoreInning']) && !after.keys().hasAny(['lineScore', 'scoreCarry', 'lineScoreInning'])) || validInningChange(before, after);
    }
    function validScoreEvent(event, before, after) {
      return event.keys().hasOnly(['gameId', 'revision', 'before', 'after', 'scoredBy', 'reason', 'recordedAt']) &&
        event.revision is int && event.revision == before.get('scoreRevision', 0) + 1 && event.revision == after.scoreRevision &&
        event.before == scoreState(before) && event.after == scoreState(after) &&
        event.scoredBy == request.auth.uid && after.scoredBy == request.auth.uid && event.recordedAt == request.time &&
        event.reason is string && event.reason.size() <= 300 && (before.status != 'completed' || event.reason.matches('.*[^\\s].*'));
    }
    function hasScoreEvent(id) {
      let event = getAfter(/databases/$(database)/documents/scoreEvents/$(id + '_' + string(request.resource.data.scoreRevision))).data;
      return validScore(request.resource.data) && validLineScore(resource.data, request.resource.data) && event.gameId == id && validScoreEvent(event, resource.data, request.resource.data);
    }
    function scoringChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['homeScore', 'awayScore', 'inning', 'half', 'balls', 'strikes', 'outs', 'bases', 'lineScore', 'scoreCarry', 'lineScoreInning', 'scoreRevision', 'scoredBy']) ||
        (request.resource.data.status != resource.data.status && request.resource.data.status in ['live', 'completed']);
    }
    match /scoreEvents/{id} {
      allow read: if organizer() || (signedIn() && profile().role == 'scorekeeper' &&
        get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.scorekeeperId == request.auth.uid);
      allow create: if signedIn() && id == request.resource.data.gameId + '_' + string(request.resource.data.revision) &&
        (organizer() || (profile().role == 'scorekeeper' && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.scorekeeperId == request.auth.uid)) &&
        validScoreEvent(request.resource.data, get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data,
          getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data);
      allow update, delete: if false;
    }
    match /games/{id} {
      allow read: if true;
      allow create: if organizer() && scheduleAdvanced() && validNewGame(request.resource.data);
      allow delete: if organizer() && scheduleAdvanced() && !hasRecordedScore(resource.data);
      allow update: if (organizer() && validAssignmentChanges() && ((!hasRecordedScore(resource.data) && !hasRecordedScore(request.resource.data)) || (request.resource.data.homeTeamId == resource.data.homeTeamId && request.resource.data.awayTeamId == resource.data.awayTeamId)) && (scheduleAdvanced() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeScore', 'awayScore', 'status', 'inning', 'half', 'balls', 'strikes', 'outs', 'bases', 'lineScore', 'scoreCarry', 'lineScoreInning', 'scoreRevision', 'scoredBy'])) && (!scoringChanged() || hasScoreEvent(id))) || (signedIn() && profile().role == 'scorekeeper' && resource.data.scorekeeperId == request.auth.uid && hasScoreEvent(id) &&
        resource.data.status in ['scheduled', 'live'] && request.resource.data.status in ['live', 'completed'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeScore', 'awayScore', 'status', 'inning', 'half', 'balls', 'strikes', 'outs', 'bases', 'lineScore', 'scoreCarry', 'lineScoreInning', 'scoreRevision', 'scoredBy']));
    }
    function hasRecordedScore(d) {
      return d.status in ['live', 'completed'] || d.get('scoreRevision', 0) > 0 || d.get('homeScore', null) != null || d.get('awayScore', null) != null;
    }
    function validNewGame(d) {
      return d.keys().hasOnly(['date', 'time', 'durationMinutes', 'homeTeamId', 'awayTeamId', 'homeName', 'awayName', 'fieldId', 'fieldName', 'status', 'homeScore', 'awayScore', 'locked', 'umpireId', 'scorekeeperId']) &&
        d.status == 'scheduled' && d.get('homeScore', null) == null && d.get('awayScore', null) == null &&
        validSeasonDate(d.date) && d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]') &&
        d.durationMinutes is int && d.durationMinutes >= 1 && d.durationMinutes <= 1440 &&
        d.homeTeamId is string && d.awayTeamId is string && d.homeTeamId != d.awayTeamId && d.fieldId is string &&
        existsAfter(/databases/$(database)/documents/teams/$(d.homeTeamId)) &&
        existsAfter(/databases/$(database)/documents/teams/$(d.awayTeamId)) &&
        existsAfter(/databases/$(database)/documents/fields/$(d.fieldId)) &&
        validName(d.homeName) && validName(d.awayName) && validName(d.fieldName) && d.get('locked', false) is bool &&
        validUmpire(d.get('umpireId', null)) && validScorekeeper(d.get('scorekeeperId', null));
    }
    function validUmpire(id) {
      return id == null || (boundedText(id, 128) && id.size() > 0 && existsAfter(/databases/$(database)/documents/umpires/$(id)));
    }
    function validScorekeeper(id) {
      return id == null || (boundedText(id, 128) && id.size() > 0 && getAfter(/databases/$(database)/documents/users/$(id)).data.role == 'scorekeeper');
    }
    function validAssignmentChanges() {
      return validGameChanges() && (request.resource.data.get('umpireId', null) == resource.data.get('umpireId', null) || validUmpire(request.resource.data.get('umpireId', null))) &&
        (request.resource.data.get('scorekeeperId', null) == resource.data.get('scorekeeperId', null) || validScorekeeper(request.resource.data.get('scorekeeperId', null)));
    }
    function validGameChanges() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['date', 'time', 'durationMinutes', 'homeTeamId', 'awayTeamId', 'homeName', 'awayName', 'fieldId', 'fieldName', 'status', 'homeScore', 'awayScore', 'locked', 'umpireId', 'scorekeeperId', 'inning', 'half', 'balls', 'strikes', 'outs', 'bases', 'lineScore', 'scoreCarry', 'lineScoreInning', 'scoreRevision', 'scoredBy']) &&
        (!changed.hasAny(['date']) || validSeasonDate(d.date)) &&
        (!changed.hasAny(['time']) || (d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))) &&
        (!changed.hasAny(['durationMinutes']) || (d.durationMinutes is int && d.durationMinutes >= 1 && d.durationMinutes <= 1440)) &&
        (!changed.hasAny(['homeTeamId', 'awayTeamId']) || (d.homeTeamId is string && d.awayTeamId is string && d.homeTeamId != d.awayTeamId &&
          existsAfter(/databases/$(database)/documents/teams/$(d.homeTeamId)) && existsAfter(/databases/$(database)/documents/teams/$(d.awayTeamId)))) &&
        (!changed.hasAny(['fieldId']) || (d.fieldId is string && existsAfter(/databases/$(database)/documents/fields/$(d.fieldId)))) &&
        (!changed.hasAny(['homeName']) || validName(d.homeName)) &&
        (!changed.hasAny(['awayName']) || validName(d.awayName)) &&
        (!changed.hasAny(['fieldName']) || validName(d.fieldName)) &&
        (!changed.hasAny(['locked']) || d.locked is bool) &&
        (!changed.hasAny(['status']) || validStatusTransition(resource.data, d));
    }
    function validStatusTransition(before, after) {
      return (before.status == 'scheduled' && after.status in ['live', 'completed']) ||
        (before.status == 'live' && after.status == 'completed') ||
        (!hasRecordedScore(before) && !hasRecordedScore(after) &&
          ((before.status == 'scheduled' && after.status == 'cancelled') || (before.status == 'cancelled' && after.status == 'scheduled')));
    }
    match /attendance/{id} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/attendance/$(id));
      allow read: if manages(resource.data.teamId) || captains(resource.data.teamId);
      allow create, update: if (manages(request.resource.data.teamId) || captains(request.resource.data.teamId)) &&
        request.resource.data.keys().hasOnly(['gameId', 'playerId', 'teamId', 'status', 'gameDate', 'gameTime', 'gameFieldId', 'revision', 'checkedBy', 'checkedAt']) &&
        id == request.resource.data.gameId + '_' + request.resource.data.playerId &&
        request.resource.data.status in ['present', 'absent', 'unmarked'] &&
        request.resource.data.checkedBy == request.auth.uid && request.resource.data.checkedAt == request.time &&
        request.resource.data.revision is int && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1) &&
        get(/databases/$(database)/documents/teamRoster/$(request.resource.data.playerId)).data.teamId == request.resource.data.teamId &&
        get(/databases/$(database)/documents/teamRoster/$(request.resource.data.playerId)).data.archived == false &&
        get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.status in ['scheduled', 'live'] &&
        request.resource.data.gameDate == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.date &&
        request.resource.data.gameTime == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.time &&
        request.resource.data.gameFieldId == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.fieldId &&
        request.resource.data.teamId in [get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.homeTeamId,
          get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.awayTeamId];
      allow delete: if false;
    }
    match /rsvps/{id} {
      allow read: if manages(resource.data.teamId) || ownsPlayer(resource.data.playerId);
      allow create, update: if request.resource.data.keys().hasOnly(['gameId', 'playerId', 'playerName', 'teamId', 'status', 'gameDate', 'gameTime', 'gameFieldId']) &&
        request.resource.data.gameDate == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.date &&
        request.resource.data.gameTime == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.time &&
        request.resource.data.gameFieldId == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.fieldId &&
        id == request.resource.data.gameId + '_' + request.resource.data.playerId &&
        request.resource.data.status in ['going', 'maybe', 'not_going'] &&
        (organizer() || ownsPlayer(request.resource.data.playerId)) &&
        get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.teamId == request.resource.data.teamId &&
        get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.get('archived', false) == false &&
        get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.status == 'scheduled' &&
        request.resource.data.teamId in [get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.homeTeamId,
          get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.awayTeamId];
      allow delete: if organizer();
    }
    match /umpires/{uid} {
      allow read: if organizer() || (signedIn() && request.auth.uid == uid);
      allow write: if organizer();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
